# Lean build artifacts
/.lake/
*.olean
*.ilean
*.trace

# Generated by `lake exe report` — the page is built by CI, never committed,
# so that the published site is always regenerated from the source of truth.
/site/

# Local build logs
build.log

# Rust and locally assembled browser artifacts
/sim_engine/target/
/sim_engine/crates/holon-ball-game/viewer/holon_ball_game.wasm
/.playwright-cli/

# Agent working artifacts — never commit
# Scratchpad: the DATA is ignored, the RECORD is not.
# A pre-registration that is not in git has no proof it preceded the data, which
# makes rule 1 of the discipline unenforceable. Markdown under scratchpad/ is the
# written record -- preregs, results, receipts -- and it is tracked. Everything
# else (36G of it at the time of writing) stays out.
/scratchpad/**
!/scratchpad/**/
!/scratchpad/**/*.md
# Instruments are record too: a prereg that names a script which is not in git
# has the same dangling-reference defect as a citation with no target.
!/scratchpad/**/*.py
# Raw job output a prereg names under "Raw:" is EVIDENCE, not scratch data -- an
# untracked raw file makes a results file cite something no clone can open. But a
# blanket *.json rule pulls in 258 MB of bulk output here (largest single file 48 MB),
# so evidence is tracked by NAMED CAMPAIGN PREFIX and the size is checked before each
# rule is added, never after.
!/scratchpad/temporal-share/closure_pilot_*.json
!/scratchpad/temporal-share/tau_sweep_*.json
!/scratchpad/temporal-share/restoration_*.json
!/scratchpad/fiber_pilot/*.json
!/scratchpad/erasure/*.json
!/scratchpad/omega/**/*.json
!/scratchpad/composition/*.json
!/scratchpad/composition/s2/*.csv
# ...but never third-party trees. A vendored package README or a downloaded
# corpus's own documentation is not OUR record; cite such things, do not commit
# them. Last matching rule wins, so these re-exclusions sit after the negations.
/scratchpad/**/node_modules/
/scratchpad/**/site-packages/
/scratchpad/**/.venv/
/scratchpad/**/*env/
/scratchpad/**/yang_corpus/

# Dalitz campaign: downloaded public data (LHCb open data, 1.1 GB) — never committed
/scratchpad/dalitz/data/
# gauge logs are cited prereg evidence, not scratch data
!/scratchpad/**/gauge*.log
!/scratchpad/omega/idjoin/*.csv
!/scratchpad/omega/omega3_n2_pinned.qpy
!/scratchpad/omega/*.log
!/scratchpad/omega/idjoin3/**
!/scratchpad/omega/tier3/**
!/scratchpad/omega/omega3_*.json
!/scratchpad/omega/tier3_diag/**
!/scratchpad/omega/tier_fresh*/**
!/scratchpad/omega/tier2_verdicts.json
